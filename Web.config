		<rewrite>
			<rules>
				<rule name="Rewrite Helpers to A Profile Page">
					<match url="^hp/([_0-9a-z-]+)" />
					<action type="Rewrite" url="/V1/Profile/Profile.aspx?profileNumber={R:1}" />
				</rule>
				<rule name="Rewrite Survivors to A Profile Page">
					<match url="^sp/([_0-9a-z-]+)" />
					<action type="Rewrite" url="/S1/Profile/Default.aspx?profileNumber={R:1}" />
				</rule>
				<rule name="Rewrite Survivors to Stories Page">
					<match url="^s/([_0-9a-z-]+)" />
					<action type="Rewrite" url="/S1/Default.aspx?profileNumber={R:1}" />
				</rule>
			  <rule name="Rewrite Nonprofit to Event">
				<match url="^NonProfitResponse/([_0-9a-z-]+)" />
				<action type="Rewrite" url="/V1/NonProfit/NonProfitCampaign.aspx?organizationEventFriendlyURLName={R:1}" />
			  </rule>
				<rule name="Rewrite to Categories">
					<match url="^c/([_0-9a-z-]+)" />
					<action type="Rewrite" url="/S1/Default.aspx?category={R:1}" />
				</rule>
				<rule name="Rewrite to Post.aspx">
					<match url="^a/([0-9]+)" />
					<action type="Rewrite" url="/S1/Post.aspx?number={R:1}" />
				</rule>
